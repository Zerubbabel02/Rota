<?xml version="1.0" encoding="utf-8"?>
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/servicedesc"
    android:requireDeviceScreenOn="false"
    android:requireDeviceUnlock="false">
    <!-- Rota-private AID (F0 = proprietary prefix, 524F5441 = "ROTA")
         instead of the standard/shared NDEF AID — avoids the OS picker
         that appears when another installed app (e.g. X) also registers
         for the standard AID. Trade-off: only phones with Rota's own
         reader-mode listener (RotaNfcReaderPlugin) running will react to
         a tap; a phone without Rota installed no longer gets any prompt. -->
    <aid-group android:description="@string/aiddescription" android:category="other">
        <aid-filter android:name="F0524F5441" />
    </aid-group>
</host-apdu-service>
